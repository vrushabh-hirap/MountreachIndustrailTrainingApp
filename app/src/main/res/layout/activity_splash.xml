<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SplashActivity"
    android:layout_gravity="center"
    android:background="@color/yellow">

    <ImageView

        android:layout_width="200dp"
        android:layout_height="200dp"
        android:id="@+id/ivSplashLogo"
        android:src="@drawable/app_logo_2_splash_screen"
        android:layout_centerInParent="true"
        >

    </ImageView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvSplashTitle"
        android:text="Foddiz App"
        android:textColor="#AC2626"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_below="@id/ivSplashLogo"
        android:layout_centerHorizontal="true"
        android:fontFamily="@font/abril_fatface">

    </TextView>
<!--        android:layout_centerHorizontal="true"-->
<!--        android:layout_centerVertical="true"-->
<!--    These two works same as the layoutcenterinparent -->



</RelativeLayout>