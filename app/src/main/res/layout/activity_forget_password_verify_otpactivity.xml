<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerifyOtpActivity"
    android:background="@color/yellow"
    android:orientation="vertical"
    android:gravity="center">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/onetimepasswordblack"
        >

    </ImageView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OTP Verification"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/abril_fatface">

    </TextView>



    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTP Receives On : "
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:textSize="14sp">

        </TextView>

        <TextView
            android:id="@+id/verify_otp_mobileno_TV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" +91 9595749934"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:layout_marginLeft="8dp">

        </TextView>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        >

        <EditText
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:id="@+id/et_otp_1"
            android:layout_margin="5dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:inputType="number"
            android:maxLength="1"
            android:gravity="center"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            >

        </EditText>
        <EditText
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:id="@+id/et_otp_2"
            android:layout_margin="5dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            >

        </EditText>
        <EditText
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:id="@+id/et_otp_3"
            android:layout_margin="5dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            >

        </EditText>
        <EditText
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:id="@+id/et_otp_4"
            android:layout_margin="5dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            >

        </EditText>
        <EditText
            android:layout_width="40dp"
            android:layout_height="45dp"
            android:id="@+id/et_otp_5"
            android:layout_margin="5dp"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:gravity="center"
            android:textStyle="normal"
            android:inputType="number"
            android:maxLength="1"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            >

        </EditText>

        <EditText
            android:id="@+id/et_otp_6"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="5dp"
            android:gravity="center"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="1"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="normal">

        </EditText>
    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Didn't Recieve the OTP ?"
            android:textColor="@color/black"
            android:textStyle="normal"
            android:textSize="14sp">

        </TextView>

        <TextView
            android:id="@+id/tv_resend_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Resend OTP"
            android:textColor="@color/orange"
            android:textStyle="bold"
            android:textSize="14sp">

        </TextView>

    </LinearLayout>


    <androidx.appcompat.widget.AppCompatButton
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/material_btn_verify"
        android:text="Verify"
        android:textColor="@color/white"
        android:background="@drawable/verify_btn_background"
        android:layout_marginTop="30dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp">

    </androidx.appcompat.widget.AppCompatButton>









</LinearLayout>