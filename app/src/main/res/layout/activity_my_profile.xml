<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MyProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">


            <ImageView
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:id="@+id/iv_my_profile_profile_photo"
                android:src="@drawable/icon_insert_image"
                android:layout_gravity="center">

            </ImageView>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/acbtn_my_profile_edit"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:background="@color/orange"
                android:layout_gravity="center"
                android:text="Edit"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white">

            </androidx.appcompat.widget.AppCompatButton>
            <TextView
                android:id="@+id/tv_my_profile_my_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Name = "
                android:textSize="24sp"
                android:layout_margin="20dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:padding="10dp"
                android:background="@drawable/without_bg_shape">

            </TextView>

            <TextView
                android:id="@+id/tv_my_profile_my_email"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Email = "
                android:layout_margin="20dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/without_bg_shape"
                android:padding="10dp">

            </TextView>

            <TextView
                android:id="@+id/tv_my_profile_my_username"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Username = "
                android:layout_margin="20dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/without_bg_shape"
                android:padding="10dp">

            </TextView>

            <TextView
                android:id="@+id/tv_my_profile_my_mobile_no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Mobileno = "
                android:layout_margin="20dp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:background="@drawable/without_bg_shape"
                android:padding="10dp">

            </TextView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignOut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sign Out"
                android:backgroundTint="@color/orange"
                android:textSize="16sp"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                android:layout_marginBottom="20dp"
                android:fontFamily=""
                android:textColor="@color/white"

                >


            </androidx.appcompat.widget.AppCompatButton>

        </LinearLayout>




    </androidx.constraintlayout.widget.ConstraintLayout>


</ScrollView>